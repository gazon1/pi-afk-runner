{
  "name": "pi-afk-runner",
  "version": "0.1.0",
  "description": "An AFK queue runner for Pi: takes a ready-for-agent issue, works it in an isolated worktree, and opens a reviewed pull request.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gazon1/pi-afk-runner.git"
  },
  "homepage": "https://github.com/gazon1/pi-afk-runner#readme",
  "bugs": {
    "url": "https://github.com/gazon1/pi-afk-runner/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-afk-runner": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npx --package=typescript@5.6.3 -y tsc -p tsconfig.json && node --eval \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "typecheck": "npx --package=typescript@5.6.3 -y tsc -p tsconfig.json --noEmit && npx --package=typescript@5.6.3 -y tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src test",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "42.0.0",
    "@quintinshaw/pi-dynamic-workflows": "3.15.0",
    "chalk": "6.0.0",
    "pi-queue-steer-factory": "0.17.11",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.6.6",
    "oxlint": "1.90.0",
    "typescript": "^5.6.3",
    "vitest": "5.0.5"
  }
}
