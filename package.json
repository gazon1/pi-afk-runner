{
  "name": "pi-afk-runner",
  "version": "0.1.0",
  "description": "An AFK queue runner: takes a ready-for-agent issue, works it in an isolated worktree, and opens a reviewed pull request.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gazon1/pi-afk-runner.git"
  },
  "homepage": "https://github.com/gazon1/pi-afk-runner#readme",
  "bugs": {
    "url": "https://github.com/gazon1/pi-afk-runner/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "afk",
    "agent",
    "pull-request"
  ],
  "bin": {
    "pi-afk-runner": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "scripts/prune-grammars.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --eval \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true})\" && node scripts/build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt 'src/**/*.ts' 'src/prompts/*.md' 'test/**/*.ts' 'scripts/**/*.mjs' 'AGENTS.md' 'README.md' 'docs/**/*.md' 'contract/**/*.md' 'skills/**/*.md' 'pipelines/**/*.md' 'systemd/**/*.md' package.json tsconfig.json tsconfig.test.json knip.json .oxfmtrc.json",
    "format:check": "oxfmt --check 'src/**/*.ts' 'src/prompts/*.md' 'test/**/*.ts' 'scripts/**/*.mjs' 'AGENTS.md' 'README.md' 'docs/**/*.md' 'contract/**/*.md' 'skills/**/*.md' 'pipelines/**/*.md' 'systemd/**/*.md' package.json tsconfig.json tsconfig.test.json knip.json .oxfmtrc.json",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run depcruise && npm run test && npm run build",
    "postinstall": "node scripts/prune-grammars.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.89",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@mastra/core": "1.81.0",
    "@mastra/memory": "1.40.0",
    "@mastra/schema-compat": "1.3.17",
    "chalk": "6.0.1",
    "citty": "^0.2.2",
    "repomix": "1.18.1",
    "simple-git": "4.0.2",
    "typebox": "1.3.27",
    "undici": "8.12.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "17.4.3",
    "knip": "6.44.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "typescript": "5.6.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
