{
  "name": "pi-afk-runner",
  "version": "0.1.0",
  "description": "An AFK queue runner for Pi: takes a ready-for-agent issue, works it in an isolated worktree, and opens a reviewed pull request.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gazon1/pi-afk-runner.git"
  },
  "homepage": "https://github.com/gazon1/pi-afk-runner#readme",
  "bugs": {
    "url": "https://github.com/gazon1/pi-afk-runner/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-afk-runner": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --eval \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src test",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@drix10/agent-flow": "1.2.7",
    "@gotgenes/pi-permission-system": "42.0.0",
    "@narumitw/pi-github-pr": "0.49.8",
    "@quintinshaw/pi-dynamic-workflows": "3.15.0",
    "@signalridge/pi-worktree": "1.4.5",
    "agents-cron": "0.15.0",
    "pi-advisor-flow": "0.14.3",
    "pi-lens": "4.4.7",
    "pi-queue-steer-factory": "0.17.11",
    "pi-subagents": "0.84.0",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.6.6",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
