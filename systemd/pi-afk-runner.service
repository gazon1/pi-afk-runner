# The AFK runner, as a systemd service.
#
# The paths are this host's paths, and they are meant to be edited: the runner
# works in a checkout of the repository it **operates on**, which is not the
# runner's own repository, and the worktrees live outside both — a worktree
# inside the repository it is a worktree of is a repository inside itself.
#
# The runner needs a `gh` token in its environment, and a `PI_AGENT_DIR` that
# holds Pi's settings and its credentials.

[Unit]
Description=AFK runner: work one issue and open a reviewed pull request
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/singularity
ExecStart=%h/.local/bin/pi-afk-runner --repo gazon1/sing --checkout %h/work/singularity --worktree-root %h/work/afk-worktrees --lock-dir %h/work/singularity/build/afk-runner --stale-after-ms 604800000
# The runner's own deadline is one hour — split between the work and review
# sessions. This is the backstop for a runner that hangs rather than works.
TimeoutStartSec=3h
