# The AFK runner, as a systemd service.
#
# The paths are this host's paths, and they are meant to be edited: the runner
# works in a checkout of the repository it **operates on**, which is not the
# runner's own repository, and the worktrees live outside both — a worktree
# inside the repository it is a worktree of is a repository inside itself.
#
# The runner needs a `gh` token in its environment, and a `PI_AGENT_DIR` that
# holds Pi's settings and its credentials.

[Unit]
Description=AFK runner: drain the ready-for-agent queue and open reviewed pull requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/singularity
# A run is capped at the runner's own budget: the three shares added up, five
# and a half hours. The claim a killed sweep left behind is taken over after
# eight hours — longer than any live run, so a run that is still going keeps
# its issue.
ExecStart=%h/.local/bin/pi-afk-runner --all --repo gazon1/sing --checkout %h/work/singularity --worktree-root %h/work/afk-worktrees --lock-dir %h/work/singularity/build/afk-runner --stale-after-ms 28800000
# A sweep has no fixed length, so any finite timeout is a kill in the middle
# of one. The runner's own deadline bounds each issue's turn instead.
TimeoutStartSec=infinity
